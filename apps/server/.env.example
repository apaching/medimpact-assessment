# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# MySQL (relational: users, roles, sharing)
# Option A — one connection string (this is what Railway gives you, usually under a
# "Connect" tab, sometimes called MYSQL_URL or MYSQL_PUBLIC_URL). If set, this wins.
MYSQL_URL=
# Option B — discrete fields, used only if MYSQL_URL is blank (handy for local dev).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=medimpact

# MongoDB (phonebook/contacts) — one connection string. Railway calls this MONGO_URL;
# either that name or MONGO_URI works here, so just paste whichever Railway shows you.
# If you add a database name to the path (recommended — otherwise mongoose defaults to
# "test"), also add ?authSource=admin, since Railway's mongo user is created in the
# admin database and the driver otherwise tries to authenticate against your named db.
MONGO_URI=mongodb://localhost:27017/medimpact

# Railway Bucket (contact profile photos, S3-compatible object storage)
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_NAME=
BUCKET_REGION=

# Email (forgot password). Leave blank to just log the reset link to the console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@medimpact.local
